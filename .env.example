# ============================================================================
# AI Job Hunter — configuración
# Copiá este archivo a .env y completá lo que necesites.
# NUNCA subas el .env a git: contiene credenciales.
# ============================================================================

# ---------------------------------------------------------------- Aplicación
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=America/Argentina/Buenos_Aires

# ------------------------------------------------------------ Base de datos
# SQLite (por defecto, no requiere nada instalado):
#   se crea en backend/jobhunter.db
# PostgreSQL / Supabase (producción):
#   DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/jobhunter
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/jobhunter

# --------------------------------------------------------------------- API
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------- IA
# "heuristic": funciona SIN API key. El motor determinístico hace todo el
#              matching, scoring y explicación. Es el modo por defecto.
# "anthropic": refina el análisis con Claude. Requiere ANTHROPIC_API_KEY.
# "openai":    refina el análisis con GPT. Requiere OPENAI_API_KEY.
#
# COSTO: el modo por defecto ("heuristic") NO cuesta nada. Todas las fuentes de
# empleo son APIs públicas gratuitas y sin cuenta. Sólo se paga si activás un LLM.
# Medido sobre los avisos reales de esta app (~2.250 tokens de entrada + ~450 de
# salida por aviso), analizando ~20 avisos por día:
#     claude-opus-5     ≈ USD 0,022 por aviso  ≈ USD 13,50 / mes
#     claude-sonnet-5   ≈ USD 0,009 por aviso  ≈ USD  5,40 / mes
#     claude-haiku-4-5  ≈ USD 0,005 por aviso  ≈ USD  2,70 / mes
# El caché por hash evita reanalizar un aviso ya visto, así que el costo real
# suele ser bastante menor que esa cuenta.
AI_PROVIDER=heuristic
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Control de costos: tope de llamadas al modelo por corrida y score mínimo
# determinístico para que un aviso "merezca" una llamada al LLM.
AI_MAX_JOBS_PER_RUN=120
AI_PREFILTER_THRESHOLD=45
AI_TIMEOUT_SECONDS=60

# -------------------------------------------------------------- Scheduler
SCHEDULER_ENABLED=true
DAILY_RUN_HOUR=7
DAILY_RUN_MINUTE=30

# ---------------------------------------------------------------- Ingesta
HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_CONCURRENCY=8
SOURCE_RATE_LIMIT_SECONDS=0.4
HTTP_USER_AGENT=AIJobHunter/1.0 (personal job search assistant)

# Lectura de HTML público (career pages con JSON-LD y SuccessFactors).
# Cuando está en true, la app verifica robots.txt antes de cada request y
# omite cualquier ruta no permitida. Apagado por defecto.
ENABLE_HTML_SCRAPING=false

# ------------------------------------------------------------- Producto
MIN_DISPLAY_SCORE=70

# ------------------------------------------ Alertas por email (LinkedIn, etc.)
# LinkedIn, Indeed, Bumeran, ZonaJobs y Glassdoor no permiten scraping, pero SÍ
# te mandan las ofertas por mail si creás una alerta de búsqueda en cada portal.
# Con esto activado, la app lee esos mails de tu casilla por IMAP y los procesa
# como cualquier otra fuente. Leer tu propio correo no es scraping.
#
# Pasos:
#   1. Creá la alerta de búsqueda en cada portal (LinkedIn: "Crear alerta de empleo").
#   2. Completá acá los datos de tu casilla.
#   3. Encendé la fuente "Alertas por email" en Config.
#
# Gmail requiere una "contraseña de aplicación" (no tu contraseña normal):
#   https://myaccount.google.com/apppasswords
IMAP_ENABLED=false
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=tu-cuenta@gmail.com
# IMAP_PASSWORD=contraseña-de-aplicacion-de-16-digitos
IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=3
IMAP_MAX_MESSAGES=60

# -------------------------------------------------------- Notificaciones
NOTIFY_EMAIL_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASSWORD=app-password-de-16-digitos
# NOTIFY_EMAIL_TO=tu-cuenta@gmail.com

NOTIFY_TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
